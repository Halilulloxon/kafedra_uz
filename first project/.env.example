# Bu faylni nusxalang:  cp .env.example .env   — so'ng qiymatlarni to'ldiring.
# .env fayli git'ga QO'SHILMAYDI (.gitignore da bor).

# --- Django ---
# Serverda doim False. Lokal kompyuterda True qilish mumkin.
DJANGO_DEBUG=False
# Yangi kalit yaratish: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Vergul bilan ajrating (bo'sh joysiz)
DJANGO_ALLOWED_HOSTS=kafedralar.uz,www.kafedralar.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://kafedralar.uz,https://www.kafedralar.uz
# SSL (https) o'rnatilgandan keyin True qiling
DJANGO_HTTPS=False

# --- MySQL ---
DB_NAME=myproject
DB_USER=kafedra_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- Email (Gmail App Password: https://myaccount.google.com/apppasswords) ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
